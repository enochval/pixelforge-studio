APP_NAME="Pixelforge Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pixelforge
DB_USERNAME=pixelforge
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Required. One API key per environment, so usage reporting for the deployed
# application is separate from local development and each can be reconciled
# independently. Each key has its own webhook URL and signing secret, set in
# the Pixelforge dashboard — the secret below must be that key's.
PIXELFORGE_BASE_URL=https://pixelforge.promptedit.dev/v1
PIXELFORGE_API_KEY=
PIXELFORGE_WEBHOOK_SECRET=

# Optional. Every value below has a default in config/pixelforge.php and is
# listed here so what is tunable is visible without reading the config.
#
# What we add to the provider's cost, in basis points. 2500 is 25%.
PIXELFORGE_MARKUP_BASIS_POINTS=2500
#
# The provider's own ceiling is three generations queued or processing at once.
# Raising this past what the account allows only converts waiting into
# rejections.
PIXELFORGE_MAX_CONCURRENT=3
#
# How long a generation is left alone before the reconciler chases it, and how
# long before it is given up on. The first is past the 60 to 90 seconds a
# [slow] generation legitimately takes, so normal work is never polled.
PIXELFORGE_POLL_AFTER=120
PIXELFORGE_ABANDON_AFTER=1800
#
# How long a signed webhook stays acceptable. Bounds how long a captured
# delivery remains replayable; the provider signs each attempt afresh, so a
# legitimate retry is never caught by it.
PIXELFORGE_WEBHOOK_TOLERANCE=300
#
# How long the published rate table is cached before being read again.
PIXELFORGE_PRICING_CACHE_SECONDS=3600
#
# Per-request timeout when calling the provider.
PIXELFORGE_TIMEOUT=15
