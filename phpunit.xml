<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>

        <!-- A suite of its own because these tests must NOT run inside a
             transaction. They assert behaviour between concurrent database
             connections, and an uncommitted row is invisible to every
             connection but the one that wrote it — so RefreshDatabase, which
             the Feature suite applies, would make the second connection see an
             empty database. These tests commit, and clean up after themselves. -->
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Every entry sets force="true". PHPUnit will not override an
             environment variable that already exists, and Docker Compose injects
             .env into the container as real environment variables, so without it
             these values are ignored and the suite inherits the development
             configuration. See tests/bootstrap.php, which handles the same
             problem for $_SERVER. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- Tests run on Postgres, not SQLite: the guarantees under test are
             Postgres constraints (partial unique indexes, SELECT FOR UPDATE,
             unique-violation semantics). SQLite would pass them falsely. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="postgres" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="pixelforge_test" force="true"/>
        <env name="DB_USERNAME" value="pixelforge" force="true"/>
        <env name="DB_PASSWORD" value="secret" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>

        <!-- A fixed signing secret, so signature verification is exercised
             against a known key rather than against whatever the environment
             happens to hold. The real secret is never needed to test the
             verification, only a consistent one. -->
        <env name="PIXELFORGE_WEBHOOK_SECRET" value="whsec_test_secret" force="true"/>
        <env name="PIXELFORGE_API_KEY" value="pf_test_key" force="true"/>
    </php>
</phpunit>
