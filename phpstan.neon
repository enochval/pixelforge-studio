includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    # Pest test files are closures with a dynamically bound $this; PHPStan cannot
    # model them without false positives, so analysis covers application code only.
    paths:
        - app
        - database

    ignoreErrors:
        # Unused starter-kit scaffolding. User does not implement MustVerifyEmail,
        # because the dashboard route is guarded by the `verified` middleware and
        # implementing it would require every new account to complete an email
        # round-trip before signing in. Email verification is not a requirement
        # here, so the controller is left in place and unused rather than wired up.
        -
            identifier: argument.type
            path: app/Http/Controllers/Auth/VerifyEmailController.php
